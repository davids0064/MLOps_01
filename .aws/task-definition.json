{
  "family": "predicciones-mlops-u2",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::194470104324:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "pacientes",
      "image": "194470104324.dkr.ecr.us-east-1.amazonaws.com/predicciones-mlops-u2/pacientes:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PATIENTS_REPORT_PATH",
          "value": "/tmp/patients/predictions.log"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/predicciones-mlops-u2",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "pacientes"
        }
      }
    }
  ]
}